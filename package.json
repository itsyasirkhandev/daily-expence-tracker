{
  "name": "rozana-expence",
  "version": "0.1.0",
  "private": true,
  "description": "Rozana Expence: a vinext starter on Cloudflare Workers with a browser-only guestbook demo.",
  "keywords": [
    "cloudflare-workers",
    "nextjs",
    "shadcn-ui",
    "starter-template",
    "tailwindcss",
    "vinext",
    "vite-plus"
  ],
  "homepage": "https://github.com/itsyasirkhandev/daily-expence-tracker#readme",
  "bugs": {
    "url": "https://github.com/itsyasirkhandev/daily-expence-tracker/issues"
  },
  "license": "Apache-2.0",
  "author": "Yasir Khan (https://github.com/itsyasirkhandev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyasirkhandev/daily-expence-tracker.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev .",
    "build": "vp build .",
    "preview": "vp preview .",
    "deploy": "vinext-cloudflare deploy",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "typegen": "cf workers types",
    "ci": "pnpm typegen && vp check && vp test && pnpm run build",
    "fallow": "fallow",
    "react:doctor": "react-doctor . --yes --no-score --no-supply-chain --blocking none"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.4",
    "fallow": "3.48.0",
    "react-doctor": "0.9.23",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.9"
